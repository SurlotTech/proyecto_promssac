spring.application.name=promssac-backend
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}

spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/promssac}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:promssac}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.keepalive-time=300000
spring.datasource.hikari.validation-timeout=5000
spring.datasource.hikari.leak-detection-threshold=0

spring.h2.console.enabled=false

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.default_batch_fetch_size=10

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB
app.storage.comentarios-upload-dir=${APP_COMENTARIOS_UPLOAD_DIR:data/comentarios}
app.storage.mobile-user-photo-dir=${APP_MOBILE_USER_PHOTO_DIR:data/usuarios-movil-fotos}

promssac.minio.enabled=${PROMSSAC_MINIO_ENABLED:true}
promssac.minio.endpoint=${PROMSSAC_MINIO_ENDPOINT:https://minio.sulortech.com}
promssac.minio.public-endpoint=${PROMSSAC_MINIO_PUBLIC_ENDPOINT:https://minio.sulortech.com}
promssac.minio.access-key=${PROMSSAC_MINIO_ACCESS_KEY:}
promssac.minio.secret-key=${PROMSSAC_MINIO_SECRET_KEY:}
promssac.minio.bucket=${PROMSSAC_MINIO_BUCKET:promssac-evidencias}
promssac.minio.comentarios-prefix=${PROMSSAC_MINIO_COMENTARIOS_PREFIX:comentarios}
promssac.minio.usuarios-movil-prefix=${PROMSSAC_MINIO_USUARIOS_MOVIL_PREFIX:usuarios-movil}
promssac.minio.presign-get-minutes=${PROMSSAC_MINIO_PRESIGN_GET_MINUTES:120}

app.jwt.secret=${APP_JWT_SECRET}
app.jwt.expiration-ms=${APP_JWT_EXPIRATION_MS:604800000}

app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:*}

app.rate-limit.login-per-minute=5
app.rate-limit.api-per-minute=120
app.rate-limit.login-burst=3
app.rate-limit.api-burst=30
app.error.include-details=false

promssac.orbitec.enabled=${PROMSSAC_ORBITEC_ENABLED:true}
promssac.orbitec.api-base-url=${PROMSSAC_ORBITEC_API_BASE_URL:https://ep.web.orbitrack.orbitec.pe}
promssac.orbitec.username=${PROMSSAC_ORBITEC_USERNAME:}
promssac.orbitec.password=${PROMSSAC_ORBITEC_PASSWORD:}
promssac.orbitec.company-slug-name=${PROMSSAC_ORBITEC_COMPANY_SLUG_NAME:dydproyectos}
promssac.orbitec.devices-limit=${PROMSSAC_ORBITEC_DEVICES_LIMIT:5000}
promssac.orbitec.devices-ordering=${PROMSSAC_ORBITEC_DEVICES_ORDERING:name}

promssac.factiliza.base-url=${PROMSSAC_FACTILIZA_BASE_URL:https://api.factiliza.com/v1}
promssac.factiliza.api-token=${PROMSSAC_FACTILIZA_TOKEN:}

promssac.resend.api-token=${RESEND_API_TOKEN:}
promssac.resend.from-name=${RESEND_FROM_NAME:SUTRACK}
promssac.resend.from-email=${RESEND_FROM_EMAIL:rutas.promssac@gmail.com}
promssac.resend.frontend-url=${FRONTEND_URL:http://localhost:3030}
